{
  "name": "GlitchRNG",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 60,
        "CharacterWalkSpeed": 18,
        "GameSettingsAvatar": "R6"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "StarterGui": {
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "Brightness": 1.2,
        "ClockTime": 0.2,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.4,
        "EnvironmentSpecularScale": 1,
        "Ambient": [
          0.133,
          0.125,
          0.21
        ],
        "OutdoorAmbient": [
          0.28,
          0.25,
          0.44
        ],
        "ExposureCompensation": 0.1
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    }
  }
}