{
  "name": "GlitchRNG",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 60,
        "CharacterWalkSpeed": 18
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "StarterGui": {
      "$properties": { "ResetPlayerGuiOnSpawn": false }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "Brightness": 1.2,
        "ClockTime": 0.2,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.4,
        "EnvironmentSpecularScale": 1,
        "Ambient": [0.04, 0.04, 0.07],
        "OutdoorAmbient": [0.12, 0.1, 0.2],
        "ExposureCompensation": 0.1
      }
    },
    "SoundService": {
      "$properties": { "RespectFilteringEnabled": true }
    },
    "Workspace": {
      "$properties": { "FilteringEnabled": true }
    }
  }
}
